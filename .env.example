# Copy to .env and fill in. Everything except the LLM settings is optional.

# --- Chat model: ollama | openai | anthropic | groq ---------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# Examples: openai -> gpt-5-mini, anthropic -> claude-sonnet-5-5, groq -> llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
# Host Ollama from inside Docker. Use http://ollama:11434 with COMPOSE_PROFILES=ollama,
# or http://localhost:11434 when running the CLI directly on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
OLLAMA_REASONING=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- Embeddings for RAG: ollama | openai ---------------------------------------
# EMBEDDING_DIM is fixed into the table on first start (nomic-embed-text=768,
# text-embedding-3-small=1536).
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Bundled containers ---------------------------------------------------------
# COMPOSE_PROFILES=ollama   # run Ollama in Docker instead of on the host
POSTGRES_PASSWORD=change-me

# --- Schedule (cron syntax, in TIMEZONE) -------------------------------------
TIMEZONE=Asia/Kolkata
GENERATE_CRON=0 6 * * *
EMAIL_CRON=0 8 * * *
RUN_ON_STARTUP=false

# --- Pipeline tuning -----------------------------------------------------------
MAX_REVISIONS=2
MIN_CRITIC_SCORE=7
IDEA_BACKLOG_MIN=3
IDEA_BATCH_SIZE=5
MAX_PARALLEL_PLATFORMS=2

# --- Telegram review bot (free: create via @BotFather) -------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated. Message the bot once; it replies with your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Email newsletter ----------------------------------------------------------
# EMAIL_PROVIDER=gmail: free. Set SMTP_USER to your Gmail address and SMTP_PASSWORD to an
#   App Password (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
#   SMTP_HOST/PORT/STARTTLS/SSL below are ignored.
# EMAIL_PROVIDER=smtp: any SMTP server (Brevo, Mailgun, Amazon SES, your own); fill all fields.
# Leave SMTP_USER/SMTP_HOST empty to disable email.
EMAIL_PROVIDER=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Defaults to SMTP_USER
EMAIL_FROM=
EMAIL_TO=
