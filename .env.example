# Copy to .env and fill in. Everything except the LLM settings is optional.

# --- Chat model: ollama | openai | anthropic | groq ---------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# Examples: openai -> gpt-5-mini, anthropic -> claude-sonnet-5-5, groq -> llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
# Host Ollama from inside Docker. Use http://ollama:11434 with COMPOSE_PROFILES=ollama,
# or http://localhost:11434 when running the CLI directly on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
OLLAMA_REASONING=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- Embeddings for RAG: ollama | openai ---------------------------------------
# EMBEDDING_DIM is fixed into the table on first start (nomic-embed-text=768,
# text-embedding-3-small=1536).
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Bundled containers ---------------------------------------------------------
# COMPOSE_PROFILES=ollama   # run Ollama in Docker instead of on the host
POSTGRES_PASSWORD=change-me

# --- Defaults for new users (each user changes theirs with /time and /timezone) ----
TIMEZONE=Asia/Kolkata
GENERATE_TIME=06:00

# --- Pipeline tuning -----------------------------------------------------------
MAX_REVISIONS=2
MIN_CRITIC_SCORE=7
IDEA_BACKLOG_MIN=3
IDEA_BATCH_SIZE=5

# --- Telegram bot (free: create via @BotFather) --------------------------------
TELEGRAM_BOT_TOKEN=
# Your chat id(s): admins never need an invite and own the knowledge/ folder.
# Message the bot /start once and check `docker compose logs bot` or use @userinfobot.
TELEGRAM_ADMIN_CHAT_IDS=
# Anyone can sign up with /start. Set a code to make it invite-only (/start <code>).
INVITE_CODE=
MAX_USERS=0

# --- Daily limits, shared by everyone (reset 00:00 UTC; 0 = unlimited) ---------
# Set these to what your free tiers allow. A request that would exceed any of them is
# refused with "try again later"; a running job that hits one is stopped.
# Local Ollama on a free VM: the limit is CPU time, so cap requests to what it can do in a day.
# Groq free tier: copy your model's requests/tokens per day and per minute from
# https://console.groq.com/settings/limits
QUOTA_LLM_REQUESTS_PER_DAY=300
QUOTA_LLM_TOKENS_PER_DAY=1500000
QUOTA_EMBED_REQUESTS_PER_DAY=2000
QUOTA_EMAILS_PER_DAY=400
QUOTA_JOBS_PER_DAY=60
QUOTA_JOBS_PER_USER_PER_DAY=6
LLM_REQUESTS_PER_MINUTE=0
EST_TOKENS_PER_LLM_REQUEST=6000

# --- Email newsletter ----------------------------------------------------------
# Each user sets their own address in Telegram with /email. This is just the admin's default.
EMAIL_TO=

# The account PostPilot sends FROM, for everyone. Set it up once; it acts as an automated
# sender (tip: create a dedicated Gmail like yourname.postpilot@gmail.com rather than your own).
# EMAIL_PROVIDER=gmail: free. SMTP_USER = that Gmail address, SMTP_PASSWORD = its App Password
#   (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
# EMAIL_PROVIDER=smtp: any SMTP service (Brevo, Mailgun, Amazon SES, ...); fill SMTP_HOST too.
# Leave SMTP_USER empty to disable email.
EMAIL_PROVIDER=gmail
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
# Only for custom SMTP whose login isn't an email address (e.g. Amazon SES):
# EMAIL_FROM=no-reply@yourdomain.com
